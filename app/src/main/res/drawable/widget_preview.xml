<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="135"
                android:endColor="#0C2622"
                android:startColor="#123A33" />
            <stroke
                android:width="1dp"
                android:color="#26584F" />
        </shape>
    </item>
    <item
        android:width="48dp"
        android:height="48dp"
        android:drawable="@drawable/ic_widget_power"
        android:gravity="center" />
</layer-list>
